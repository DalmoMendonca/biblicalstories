{"page":178,"id":"p24283971","width":1482.0,"height":2232.0,"blocks":[{"id":"tb24283971","hpos":0.0,"vpos":0.0,"width":1482.0,"height":2232.0,"lines":[{"id":"tl178-0","hpos":253.0,"vpos":188.0,"width":832.0,"height":23.0,"text":"roS Die 17 . Historie . Von Samuel ."},{"id":"tl178-1","hpos":300.0,"vpos":260.0,"width":957.0,"height":35.0,"text":"Das hat Simfon gethan , ist aber gar übel dar"},{"id":"tl178-2","hpos":347.0,"vpos":311.0,"width":264.0,"height":38.0,"text":"ben gefahren ."},{"id":"tl178-3","hpos":304.0,"vpos":360.0,"width":955.0,"height":41.0,"text":"U . Den Weibern muß man keine Heimlich"},{"id":"tl178-4","hpos":253.0,"vpos":413.0,"width":414.0,"height":34.0,"text":"keiten anvertrauen ."},{"id":"tl178-5","hpos":308.0,"vpos":458.0,"width":954.0,"height":41.0,"text":"Das hatSinuon zu feinem Schaden . sowvhl mit sei"},{"id":"tl178-6","hpos":357.0,"vpos":518.0,"width":903.0,"height":27.0,"text":"nem Räthsel , als auch mit seiner Stärke erfahren ."},{"id":"tl178-7","hpos":307.0,"vpos":559.0,"width":953.0,"height":36.0,"text":"III . Sprach hat wohl recht gesagt : wein und"},{"id":"tl178-8","hpos":256.0,"vpos":608.0,"width":663.0,"height":38.0,"text":"Weiber betöhren die Menschen ."},{"id":"tl178-9","hpos":308.0,"vpos":659.0,"width":955.0,"height":37.0,"text":"DaS widerfuhr Simsen , den brachte die liebkosende"},{"id":"tl178-10","hpos":355.0,"vpos":707.0,"width":908.0,"height":37.0,"text":"Delila um seine Starke , um seine Augen , und"},{"id":"tl178-11","hpos":360.0,"vpos":760.0,"width":436.0,"height":38.0,"text":"endlich um sein Leben ."},{"id":"tl178-12","hpos":471.0,"vpos":817.0,"width":580.0,"height":45.0,"text":"Gottselige Gedanken ."},{"id":"tl178-13","hpos":259.0,"vpos":883.0,"width":1006.0,"height":42.0,"text":"An Simfon kan man sehn , wie sich die Wollust"},{"id":"tl178-14","hpos":642.0,"vpos":933.0,"width":119.0,"height":40.0,"text":"endet ,"},{"id":"tl178-15","hpos":310.0,"vpos":985.0,"width":957.0,"height":30.0,"text":"Und wie sie stürzen kan in Jammer und in Noth :"},{"id":"tl178-16","hpos":262.0,"vpos":1033.0,"width":1008.0,"height":41.0,"text":"Erst wich die Kraft von ihm , darnach ward er ge"},{"id":"tl178-17","hpos":649.0,"vpos":1079.0,"width":153.0,"height":43.0,"text":"blendet ,"},{"id":"tl178-18","hpos":314.0,"vpos":1136.0,"width":957.0,"height":37.0,"text":"Und endlich schlug das Haus ihn und die Feinde"},{"id":"tl178-19","hpos":656.0,"vpos":1182.0,"width":96.0,"height":44.0,"text":"tod ;"},{"id":"tl178-20","hpos":265.0,"vpos":1232.0,"width":1006.0,"height":38.0,"text":"Diß Beyspihl wil ich mir stets zu Gemüthe ziehen ,"},{"id":"tl178-21","hpos":265.0,"vpos":1287.0,"width":933.0,"height":30.0,"text":"Und alle Hurerry gleich als den Teufel siiehen ."},{"id":"tl178-22","hpos":529.0,"vpos":1359.0,"width":484.0,"height":35.0,"text":"Die XXVII . Historie ."},{"id":"tl178-23","hpos":534.0,"vpos":1429.0,"width":451.0,"height":56.0,"text":"Von Samuel ."},{"id":"tl178-24","hpos":532.0,"vpos":1546.0,"width":515.0,"height":24.0,"text":"r . Sam . I . und II . Cap ."},{"id":"tl178-25","hpos":617.0,"vpos":1608.0,"width":661.0,"height":46.0,"text":"hatte zwey Weiber , eine hieß"},{"id":"tl178-26","hpos":489.0,"vpos":1665.0,"width":787.0,"height":40.0,"text":"Hanna , und die andere Peninna ."},{"id":"tl178-27","hpos":277.0,"vpos":1740.0,"width":999.0,"height":29.0,"text":"2 . Unter denselben war Peninna fruchtbar ,"},{"id":"tl178-28","hpos":278.0,"vpos":1785.0,"width":944.0,"height":36.0,"text":"und Hanna hingegen hatte keine Kinder ."},{"id":"tl178-29","hpos":534.0,"vpos":1869.0,"width":490.0,"height":45.0,"text":"Deutliche Fragen ."},{"id":"tl178-30","hpos":340.0,"vpos":1945.0,"width":778.0,"height":36.0,"text":"Was hatte Elkana vor zwey Weiber ?"},{"id":"tl178-31","hpos":284.0,"vpos":2010.0,"width":649.0,"height":23.0,"text":"2 . Was hatten sie vor Kinder ?"}]}]}
